{
  "manifest_version": 3,
  "name": "GemRate POP 日次受領",
  "version": "0.1.0",
  "description": "確認済み日本語PSAセットの通常公開ページとCSVだけを日次確認。初期状態は停止。",
  "permissions": ["alarms", "storage", "scripting", "downloads"],
  "host_permissions": ["https://www.gemrate.com/*", "https://urm759.github.io/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_popup": "popup.html"}
}
